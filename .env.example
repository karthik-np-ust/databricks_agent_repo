# Copy and fill in. Never put real values in this file: it is committed.
#
# Local (two terminals): copy to .env; every process reads it, but each one only *uses* its own lines.
# Docker Compose: split into .env.dataplane / .env.control / .env.console so each container only
# receives its own secrets (trust boundary, see docker-compose.yml).
#
# [all]        every process     [data]   pipeline-agent dataplane
# [control]    pipeline-agent control     [console] pipeline-agent console

# --- [all] behaviour
AGENT_ENABLED=true              # kill switch (the console can only turn it off)
AGENT_DRY_RUN=true              # start in dry run on a real workspace; set false once decisions look right
AGENT_POLL_INTERVAL_SECONDS=60
AGENT_DATABASE_URL=sqlite:///./agent_state.db
# AGENT_DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent
AGENT_EVIDENCE_DIR=var/evidence

# --- [data] Databricks: ONLY the data plane needs these. Use a bot user / service principal token.
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
AGENT_TRUSTED_KEYS=["var/keys/signing_key.pub.pem"]   # public keys whose signed requests it executes

# --- [control] signing key (private) and LangGraph checkpoints
AGENT_SIGNING_KEY_PATH=var/keys/signing_key.pem      # pipeline-agent keys generate --out var/keys
AGENT_CHECKPOINT_URL=var/checkpoints.sqlite          # or postgresql://... when hosted
AGENT_NOTIFY_KIND=console                            # console | teams | slack | generic
# AGENT_NOTIFY_WEBHOOK_URL=https://...

# --- [control, console] LLM (triage, fix writer, Testing agent; console: re-run diagnosis)
AGENT_LLM_ENABLED=false
OPENROUTER_API_KEY=

# --- [control, console] the agent's OWN GitHub identity (never yours): fixes (control), PR diffs (console)
AGENT_FIX_ENABLED=false
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=          # keep the .pem OUTSIDE the repo
# GITHUB_TOKEN=                       # alternative: bot account token

# --- [console]
# AGENT_CONSOLE_SECRET=               # signs session tokens; random per start when unset
# AGENT_CONSOLE_AUTH=demo             # demo | oidc (OIDC not built yet)
