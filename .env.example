# Copy to .env and fill in. Never put real values in this file: it is committed.

# --- agent behaviour
AGENT_ENABLED=true              # kill switch
AGENT_DRY_RUN=true              # start in dry run on a real workspace; set false once decisions look right
AGENT_POLL_INTERVAL_SECONDS=60
AGENT_DATABASE_URL=sqlite:///./agent_state.db
# AGENT_DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent

# --- notifications: console | teams | slack | generic
AGENT_NOTIFY_KIND=console
# AGENT_NOTIFY_WEBHOOK_URL=https://...

# --- Databricks (agent plugin + scripts). Use a PAT for a dedicated bot user if possible.
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=

# --- LLM triage (Phase 2)
AGENT_LLM_ENABLED=false
OPENROUTER_API_KEY=

# --- Fix flow (Phase 3): the agent's OWN GitHub identity, never yours
AGENT_FIX_ENABLED=false
# Preferred: GitHub App (see docs/13-github-setup.md section 12)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=          # keep the .pem OUTSIDE the repo
# Alternative: bot account token
GITHUB_TOKEN=
